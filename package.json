{
  "name": "promotify-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev --workspace=@promotify/backend\" \"npm run dev --workspace=@promotify/frontend\"",
    "dev:backend": "npm run dev --workspace=@promotify/backend",
    "dev:frontend": "npm run dev --workspace=@promotify/frontend",
    "build": "npm run build --workspace=@promotify/frontend",
    "typecheck": "npm run typecheck --workspace=@promotify/backend && npm run typecheck --workspace=@promotify/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
